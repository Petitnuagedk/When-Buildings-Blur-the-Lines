<?xml version="1.0" encoding="utf-8"?>
<!--
    Mitsuba 3 scene for FOBA-vs-Sionna comparison
    Single building: x=[40,60] y=[-10,10] z=[0,15]
    Ground plane: 200m x 200m
    Band: 2.4 GHz
-->
<scene version="3.0.0">

    <!-- ===================== MATERIALS ===================== -->

    <bsdf type="itu-radio-material" id="mat-concrete">
        <string name="type" value="concrete"/>
    </bsdf>

    <bsdf type="itu-radio-material" id="mat-ground">
        <string name="type" value="concrete"/>
    </bsdf>

    <!-- ===================== GROUND PLANE ===================== -->
    <shape type="rectangle" id="ground_plane">
        <ref id="mat-ground"/>
        <transform name="to_world">
            <scale x="200.0" y="200.0" z="1.0"/>
            <translate x="50.0" y="0.0" z="0.0"/>
        </transform>
    </shape>

    <!-- ===================== BUILDING ===================== -->
    <!-- Single building: x=[40,60] y=[-10,10] z=[0,15]
         Center: (50, 0, 7.5)   Half-extents: (10, 10, 7.5) -->
    <shape type="cube" id="building_00">
        <ref id="mat-concrete"/>
        <transform name="to_world">
            <scale x="10.0" y="10.0" z="7.5"/>
            <translate x="50.0" y="0.0" z="7.5"/>
        </transform>
    </shape>

</scene>
